# Skopiuj ten plik jako .env i uzupełnij (Supabase → Project Settings → API Keys).
# Oba klucze są publiczne z założenia – dane chroni RLS w bazie.
# NIGDY nie wpisuj tu klucza "secret" / "service_role".
EXPO_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
# Klucz "publishable" (sb_publishable_…) albo starszy "anon public"
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
